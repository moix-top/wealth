# ── AWS / DynamoDB ─────────────────────────────────────────
# Cópialo a .env.local para dev, o configúralo en Vercel → Settings → Env Vars.
# Sin AWS_ACCESS_KEY_ID/SECRET la app arranca en MODO MEMORIA: funciona, pero
# los datos no persisten entre invocaciones. Los valores de producción los
# imprime scripts/setup-aws.sh (usuario wealth-data-vercel).
AWS_REGION=eu-west-1
DYNAMODB_TABLE=wealth-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Opcional ───────────────────────────────────────────────
# Apunta a DynamoDB Local para pruebas de integración o para el import local.
# DYNAMODB_ENDPOINT=http://localhost:8000

# ── Acceso: login con Google (Auth.js v5) ──────────────────
# El registro es ABIERTO: cualquier cuenta de Google con email verificado puede
# entrar y tendrá su propio espacio de datos, aislado del resto.
#
# Clave de firma de la cookie de sesión. Genérala con:  openssl rand -base64 32
# El MISMO valor en Production y Preview. Es secreta.
AUTH_SECRET=
# Credenciales del OAuth client de Google (tipo "Aplicación web").
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Deriva la URL de callback del Host de cada petición.
AUTH_TRUST_HOST=true
#
# ⚠️  NO definas AUTH_URL: fijaría el callback a un único dominio y rompería el
# login desde cualquier otro.
#
# En Google Cloud Console hay que registrar un redirect URI por dominio:
#   https://wealth.moix.top/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
